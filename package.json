{
  "name": "wird",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "ui:snap": "bun run build && node scripts/ui-snapshots.mjs",
    "test:e2e": "bun run build && for f in tests/e2e/*.spec.mjs; do node \"$f\" || exit 1; done",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open": "cap open ios",
    "cap:open:android": "cap open android",
    "build:ios": "tsc -b && vite build && cap sync ios",
    "build:android": "tsc -b && vite build && cap sync android",
    "ios:release": "bash scripts/ios-release.sh",
    "ios:upload": "bash scripts/ios-release.sh --upload",
    "ios:sim": "bash scripts/ios-sim.sh",
    "ios:sim:shot": "bash scripts/ios-sim.sh --screenshot",
    "apk:debug": "bun run build:android && cd android && JAVA_HOME=\"${JAVA_HOME:-/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home}\" ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/share": "^8.0.3",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "oxlint": "^1.89.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
